{
  "name": "Zammad 7 Helpdesk and Ticketing",
  "description": "Email, chat and web tickets in one helpdesk. Open Zendesk alternative.",
  "category": "Other",
  "tags": [
    "zammad",
    "helpdesk",
    "ticketing",
    "customer-support",
    "live-chat",
    "elasticsearch",
    "postgres"
  ],
  "image": "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/zammad.svg",
  "upstream": {
    "repo": "zammad/zammad-docker-compose",
    "version": "v17.5.2 (Zammad 7.2.2)",
    "checked": "2026-10-11"
  },
  "services": {
    "zammad-nginx": {
      "icon": "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/zammad.svg",
      "source": {
        "repo": "baranberkay96/zammad-railway",
        "rootDirectory": "/services/zammad"
      },
      "startCommand": "/usr/local/bin/railway-zammad zammad-nginx",
      "preDeployCommand": null,
      "healthcheckPath": "/",
      "healthcheckTimeout": 1200,
      "restartPolicyType": "ALWAYS",
      "restartPolicyMaxRetries": null,
      "numReplicas": 1,
      "cronSchedule": null,
      "publicDomain": true,
      "targetPort": 8080,
      "tcpProxy": null,
      "volume": null,
      "variables": {
        "POSTGRESQL_HOST": {
          "defaultValue": "${{zammad-railsserver.POSTGRESQL_HOST}}",
          "description": "PostgreSQL host (private network).",
          "required": false
        },
        "POSTGRESQL_PORT": {
          "defaultValue": "${{zammad-railsserver.POSTGRESQL_PORT}}",
          "description": "PostgreSQL port.",
          "required": false
        },
        "POSTGRESQL_USER": {
          "defaultValue": "${{zammad-railsserver.POSTGRESQL_USER}}",
          "description": "PostgreSQL user.",
          "required": false
        },
        "POSTGRESQL_PASS": {
          "defaultValue": "${{zammad-railsserver.POSTGRESQL_PASS}}",
          "description": "PostgreSQL password.",
          "required": false
        },
        "POSTGRESQL_DB": {
          "defaultValue": "${{zammad-railsserver.POSTGRESQL_DB}}",
          "description": "Database name; created by zammad-init on first deploy.",
          "required": false
        },
        "POSTGRESQL_DB_CREATE": {
          "defaultValue": "${{zammad-railsserver.POSTGRESQL_DB_CREATE}}",
          "description": "Let zammad-init create the database (the Railway Postgres user may create databases).",
          "required": false
        },
        "POSTGRESQL_OPTIONS": {
          "defaultValue": "${{zammad-railsserver.POSTGRESQL_OPTIONS}}",
          "description": "Rails connection pool options (must be at least MAX_THREADS).",
          "required": false
        },
        "REDIS_URL": {
          "defaultValue": "${{zammad-railsserver.REDIS_URL}}",
          "description": "Redis for websocket sessions and background coordination.",
          "required": false
        },
        "MEMCACHE_SERVERS": {
          "defaultValue": "${{zammad-railsserver.MEMCACHE_SERVERS}}",
          "description": "Memcached for the Rails cache.",
          "required": false
        },
        "ELASTICSEARCH_ENABLED": {
          "defaultValue": "${{zammad-railsserver.ELASTICSEARCH_ENABLED}}",
          "description": "Use Elasticsearch for search (recommended by Zammad).",
          "required": false
        },
        "ELASTICSEARCH_SCHEMA": {
          "defaultValue": "${{zammad-railsserver.ELASTICSEARCH_SCHEMA}}",
          "description": "Elasticsearch scheme (plain HTTP on the private network).",
          "required": false
        },
        "ELASTICSEARCH_HOST": {
          "defaultValue": "${{zammad-railsserver.ELASTICSEARCH_HOST}}",
          "description": "Elasticsearch host.",
          "required": false
        },
        "ELASTICSEARCH_PORT": {
          "defaultValue": "${{zammad-railsserver.ELASTICSEARCH_PORT}}",
          "description": "Elasticsearch port.",
          "required": false
        },
        "ELASTICSEARCH_USER": {
          "defaultValue": "${{zammad-railsserver.ELASTICSEARCH_USER}}",
          "description": "Elasticsearch user.",
          "required": false
        },
        "ELASTICSEARCH_PASS": {
          "defaultValue": "${{zammad-railsserver.ELASTICSEARCH_PASS}}",
          "description": "Elasticsearch password.",
          "required": false
        },
        "ELASTICSEARCH_NAMESPACE": {
          "defaultValue": "${{zammad-railsserver.ELASTICSEARCH_NAMESPACE}}",
          "description": "Prefix of Zammad's Elasticsearch indexes.",
          "required": false
        },
        "RAILS_TRUSTED_PROXIES": {
          "defaultValue": "${{zammad-railsserver.RAILS_TRUSTED_PROXIES}}",
          "description": "Proxies (nginx, Railway's edge) whose X-Forwarded-For Zammad trusts, for real client IPs and rate limiting.",
          "required": false
        },
        "TZ": {
          "defaultValue": "${{zammad-railsserver.TZ}}",
          "description": "Container time zone (logs, backup schedule).",
          "required": false
        },
        "PORT": {
          "defaultValue": "8080",
          "description": "Port nginx listens on; Railway routes the public domain and its healthcheck here.",
          "required": false
        },
        "NGINX_PORT": {
          "defaultValue": "8080",
          "description": "Port nginx listens on (IPv4 and IPv6).",
          "required": false
        },
        "NGINX_SERVER_SCHEME": {
          "defaultValue": "https",
          "description": "Scheme passed to Zammad in X-Forwarded-Proto; Railway terminates TLS, so https (otherwise logins fail with CSRF errors).",
          "required": false
        },
        "NGINX_CLIENT_MAX_BODY_SIZE": {
          "defaultValue": "50M",
          "description": "Maximum upload size.",
          "required": false
        },
        "ZAMMAD_RAILSSERVER_HOST": {
          "defaultValue": "${{zammad-railsserver.RAILWAY_PRIVATE_DOMAIN}}",
          "description": "Rails server (private network).",
          "required": false
        },
        "ZAMMAD_RAILSSERVER_PORT": {
          "defaultValue": "${{zammad-railsserver.ZAMMAD_RAILSSERVER_PORT}}",
          "description": "Rails server port.",
          "required": false
        },
        "ZAMMAD_WEBSOCKET_HOST": {
          "defaultValue": "${{zammad-websocket.RAILWAY_PRIVATE_DOMAIN}}",
          "description": "Websocket server (private network).",
          "required": false
        },
        "ZAMMAD_WEBSOCKET_PORT": {
          "defaultValue": "${{zammad-websocket.ZAMMAD_WEBSOCKET_PORT}}",
          "description": "Websocket server port.",
          "required": false
        }
      }
    },
    "zammad-railsserver": {
      "icon": "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/zammad.svg",
      "source": {
        "repo": "baranberkay96/zammad-railway",
        "rootDirectory": "/services/zammad"
      },
      "startCommand": "/usr/local/bin/railway-zammad zammad-railsserver",
