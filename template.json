      "tcpProxy": null,
      "volume": {
        "mountPath": "/var/tmp/zammad"
      },
      "variables": {
        "POSTGRESQL_HOST": {
          "defaultValue": "${{zammad-railsserver.POSTGRESQL_HOST}}",
          "description": "PostgreSQL host (private network).",
          "required": false
        },
        "POSTGRESQL_PORT": {
          "defaultValue": "${{zammad-railsserver.POSTGRESQL_PORT}}",
          "description": "PostgreSQL port.",
          "required": false
        },
        "POSTGRESQL_USER": {
          "defaultValue": "${{zammad-railsserver.POSTGRESQL_USER}}",
          "description": "PostgreSQL user.",
          "required": false
        },
        "POSTGRESQL_PASS": {
          "defaultValue": "${{zammad-railsserver.POSTGRESQL_PASS}}",
          "description": "PostgreSQL password.",
          "required": false
        },
        "POSTGRESQL_DB": {
          "defaultValue": "${{zammad-railsserver.POSTGRESQL_DB}}",
          "description": "Database name; created by zammad-init on first deploy.",
          "required": false
        },
        "POSTGRESQL_DB_CREATE": {
          "defaultValue": "${{zammad-railsserver.POSTGRESQL_DB_CREATE}}",
          "description": "Let zammad-init create the database (the Railway Postgres user may create databases).",
          "required": false
        },
        "POSTGRESQL_OPTIONS": {
          "defaultValue": "${{zammad-railsserver.POSTGRESQL_OPTIONS}}",
          "description": "Rails connection pool options (must be at least MAX_THREADS).",
          "required": false
        },
        "REDIS_URL": {
          "defaultValue": "${{zammad-railsserver.REDIS_URL}}",
          "description": "Redis for websocket sessions and background coordination.",
          "required": false
        },
        "MEMCACHE_SERVERS": {
          "defaultValue": "${{zammad-railsserver.MEMCACHE_SERVERS}}",
          "description": "Memcached for the Rails cache.",
          "required": false
        },
        "ELASTICSEARCH_ENABLED": {
          "defaultValue": "${{zammad-railsserver.ELASTICSEARCH_ENABLED}}",
          "description": "Use Elasticsearch for search (recommended by Zammad).",
          "required": false
        },
        "ELASTICSEARCH_SCHEMA": {
          "defaultValue": "${{zammad-railsserver.ELASTICSEARCH_SCHEMA}}",
          "description": "Elasticsearch scheme (plain HTTP on the private network).",
          "required": false
        },
        "ELASTICSEARCH_HOST": {
          "defaultValue": "${{zammad-railsserver.ELASTICSEARCH_HOST}}",
          "description": "Elasticsearch host.",
          "required": false
        },
        "ELASTICSEARCH_PORT": {
          "defaultValue": "${{zammad-railsserver.ELASTICSEARCH_PORT}}",
          "description": "Elasticsearch port.",
          "required": false
        },
        "ELASTICSEARCH_USER": {
          "defaultValue": "${{zammad-railsserver.ELASTICSEARCH_USER}}",
          "description": "Elasticsearch user.",
          "required": false
        },
        "ELASTICSEARCH_PASS": {
          "defaultValue": "${{zammad-railsserver.ELASTICSEARCH_PASS}}",
          "description": "Elasticsearch password.",
          "required": false
        },
        "ELASTICSEARCH_NAMESPACE": {
          "defaultValue": "${{zammad-railsserver.ELASTICSEARCH_NAMESPACE}}",
          "description": "Prefix of Zammad's Elasticsearch indexes.",
          "required": false
        },
        "RAILS_TRUSTED_PROXIES": {
          "defaultValue": "${{zammad-railsserver.RAILS_TRUSTED_PROXIES}}",
          "description": "Proxies (nginx, Railway's edge) whose X-Forwarded-For Zammad trusts, for real client IPs and rate limiting.",
          "required": false
        },
        "TZ": {
          "defaultValue": "${{zammad-railsserver.TZ}}",
          "description": "Container time zone (logs, backup schedule).",
          "required": false
        },
        "BACKUP_DIR": {
          "defaultValue": "/var/tmp/zammad",
          "description": "Backup directory (this service's volume).",
          "required": false
        },
        "BACKUP_TIME": {
          "defaultValue": "03:00",
          "description": "Daily backup time (TZ).",
          "required": false
        },
        "HOLD_DAYS": {
          "defaultValue": "10",
          "description": "Days to keep backups.",
          "required": false
        },
        "BACKUP_ON_START": {
          "defaultValue": "false",
          "description": "Also back up whenever the service starts.",
          "required": false
        },
        "NO_FILE_BACKUP": {
          "defaultValue": "yes",
          "description": "Skip the storage-directory archive: attachments are in PostgreSQL (or S3), so the database dump is the backup.",
          "required": false
        },
        "RAILWAY_RUN_UID": {
          "defaultValue": "0",
          "description": "Run as root so the backup volume (mounted root-owned) is writable, as upstream runs this container.",
          "required": false
        }
      }
    },
    "Elasticsearch": {
      "icon": "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/elasticsearch.svg",
      "source": {
        "repo": "baranberkay96/zammad-railway",
        "rootDirectory": "/services/elasticsearch"
      },
      "startCommand": null,
      "preDeployCommand": null,
      "healthcheckPath": null,
      "healthcheckTimeout": null,
      "restartPolicyType": "ON_FAILURE",
      "restartPolicyMaxRetries": 10,
      "numReplicas": 1,
      "cronSchedule": null,
      "publicDomain": false,
      "targetPort": null,
      "tcpProxy": null,
      "volume": {
        "mountPath": "/usr/share/elasticsearch/data"
      },
      "variables": {
        "discovery.type": {
          "defaultValue": "single-node",
          "description": "Single-node cluster (also skips production bootstrap checks).",
          "required": false
        },
        "xpack.security.enabled": {
          "defaultValue": "true",
          "description": "Require the elastic user's password.",
          "required": false
        },
        "xpack.security.http.ssl.enabled": {
          "defaultValue": "false",
          "description": "Plain HTTP inside the private network.",
          "required": false
        },
        "xpack.security.transport.ssl.enabled": {
          "defaultValue": "false",
          "description": "No transport TLS for a single node.",
          "required": false
        },
        "ELASTIC_PASSWORD": {
          "defaultValue": "${{secret(32, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
          "description": "Password of the elastic user (generated).",
          "required": false
        },
        "ES_JAVA_OPTS": {
          "defaultValue": "-Xms1g -Xmx1g",
          "description": "JVM heap (upstream default 1 GB). Keep about half of the RAM you give Elasticsearch.",
          "required": false
        },
        "network.host": {
          "defaultValue": "0.0.0.0",
          "description": "Bind address. 0.0.0.0, not '::': the image writes these settings to YAML unquoted and '::' breaks the parse.",
          "required": false
        },
        "node.store.allow_mmap": {
          "defaultValue": "false",
          "description": "Do not depend on the host's vm.max_map_count, which containers cannot change.",
          "required": false
        },
        "bootstrap.memory_lock": {
          "defaultValue": "false",
          "description": "memlock ulimits cannot be raised on Railway.",
          "required": false
        },
        "ingest.geoip.downloader.enabled": {
          "defaultValue": "false",
          "description": "Skip GeoIP database downloads (unused by Zammad).",
          "required": false
        },
        "xpack.ml.enabled": {
          "defaultValue": "false",
          "description": "Machine learning features off (unused, saves memory).",
          "required": false
        },
        "RAILWAY_DEPLOYMENT_DRAINING_SECONDS": {
          "defaultValue": "60",
          "description": "Allow a clean shutdown on redeploy.",
          "required": false
        }
      }
    },
    "Memcached": {
      "icon": "https://cdn.jsdelivr.net/gh/selfhst/icons/svg/memcached.svg",
